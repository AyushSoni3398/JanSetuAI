# Copy this file to .env and adjust as needed.
# .env is gitignored; this template is committed.

# SQLite (default for local hackathon dev) - file is created automatically.
DATABASE_URL=sqlite:///./jansetu.db

# To switch to Postgres later, only this line changes:
# DATABASE_URL=postgresql+psycopg2://jansetu:jansetu@localhost:5432/jansetu
# (and add psycopg2-binary to requirements.txt)

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
