# Copy this file to .env and adjust as needed.
# .env is gitignored; this template is committed.

# SQLite (default for local hackathon dev) - file is created automatically.
DATABASE_URL=sqlite:///./jansetu.db

# To switch to Postgres later, only this line changes:
# DATABASE_URL=postgresql+psycopg2://jansetu:jansetu@localhost:5432/jansetu
# (and add psycopg2-binary to requirements.txt)

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI analysis (M5) ---
# Leave blank to run the deterministic mock analyser (no network, no cost).
# Set a real key to use Claude for language detection + translation + classification.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Alternative provider - a free Google AI Studio key (aistudio.google.com).
# If both are set, Gemini is used first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
