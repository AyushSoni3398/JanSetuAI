# WhatsApp intake. Digits only, country code, no leading "+".
# Defaults in src/config.js are used when this file is absent.
VITE_WHATSAPP_NUMBER=14155238886

# Twilio sandbox join code. Set to empty once on an approved
# WhatsApp Business number and the join step disappears from the UI.
# Your sandbox's own join code - shown on the Twilio Sandbox tab.
VITE_WHATSAPP_JOIN_CODE=join cut-shade
